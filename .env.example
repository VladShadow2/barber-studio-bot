# Telegram bot token from BotFather. Required. Never commit the real value.
BOT_TOKEN=

# Comma-separated Telegram user ids allowed to use admin actions.
ADMIN_IDS=

# Runtime PostgreSQL URL. The driver must be asyncpg. SQLite is not used.
# Docker Compose publishes the optional local server as:
#   postgresql+asyncpg://booking:booking@localhost:5432/booking
# Without Docker, install PostgreSQL yourself and create an empty database:
#   CREATE USER booking WITH PASSWORD 'booking';
#   CREATE DATABASE booking OWNER booking;
#   CREATE DATABASE booking_test OWNER booking;
DATABASE_URL=postgresql+asyncpg://booking:booking@localhost:5432/booking

# Optional direct Postgres URL for Alembic when DATABASE_URL uses a pooler.
# Leave empty to migrate through DATABASE_URL. Use Supabase's direct 5432 URL here.
MIGRATION_DATABASE_URL=

# Tests that need Postgres are skipped unless this points at a disposable database.
# The database name must contain "test". pytest drops and recreates its tables.
TEST_DATABASE_URL=postgresql+asyncpg://booking:booking@localhost:5432/booking_test

# Business timezone used when rendering appointment times.
TIMEZONE=Europe/Kyiv

# Currency label shown next to prices.
CURRENCY=UAH

# Grid size for offered appointment times.
SLOT_MINUTES=30

# Hours before a confirmed visit to send reminders. One or more, such as 24 or 24,2.
REMINDER_HOURS=24

# How often a running process looks for due reminders, in seconds.
REMINDER_POLL_SECONDS=30

# Customers can cancel until this many hours before the visit. Admins can cancel later.
CANCEL_BEFORE_HOURS=2

# How many local days ahead the date list looks.
BOOKING_DAYS_AHEAD=14

# Do not offer a slot that starts sooner than this many minutes from now.
MIN_LEAD_MINUTES=30

# Unfinished booking drafts expire after this many minutes.
DRAFT_TTL_MINUTES=60

# polling for local development, webhook for the cloud service. Never run both.
BOT_MODE=polling

# Required only when BOT_MODE=webhook. Public https origin, no path.
WEBHOOK_BASE_URL=

# Required only when BOT_MODE=webhook. At least 16 characters. Never commit it.
WEBHOOK_SECRET=

# HTTP port for webhook mode. Render sets PORT; local webhook can keep 8080.
PORT=8080

# Logging level for the process.
LOG_LEVEL=INFO

# Telegram bot token from BotFather. Required.
BOT_TOKEN=

# Comma-separated Telegram user ids allowed to use admin actions.
ADMIN_IDS=

# SQLite file for bookings and reminders. Dialog state is not stored here.
DATABASE_URL=sqlite:///./booking.db

# Business timezone used when rendering appointment times.
TIMEZONE=Europe/Kyiv

# Currency label shown next to prices.
CURRENCY=UAH

# Grid size for offered appointment times.
SLOT_MINUTES=30

# Hours before a confirmed visit to send reminders.
REMINDER_HOURS=24,2

# Logging level for the process.
LOG_LEVEL=INFO
